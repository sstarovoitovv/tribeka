Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# Canonical production host; never construct redirects from an untrusted Host.
RewriteCond %{HTTP_HOST} ^www\.xn--80abmkm6an\.xn--p1ai(?::[0-9]+)?$ [NC]
RewriteRule ^ https://xn--80abmkm6an.xn--p1ai%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^xn--80abmkm6an\.xn--p1ai(?::[0-9]+)?$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://xn--80abmkm6an.xn--p1ai%{REQUEST_URI} [R=301,L,NE]

# GENERATED_SERVICE_REDIRECTS

# Only the two intended PHP endpoints are public. Block private/source paths even
# if a future release accidentally contains a file in one of these directories.
RewriteRule ^(?:api/_lib|server|database|backups?|uploads?|tribeka-private|src|tests|scripts|docs|node_modules)(?:/|$) - [R=404,L,NC]
RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [R=404,L]
RewriteCond %{REQUEST_URI} !^/api/(?:request|analytics)\.php$
RewriteRule \.(?:php[0-9]*|phtml|phar)(?:/|$) - [R=404,L,NC]
<FilesMatch "(?i)(?:\.(?:bak|backup|old|orig|save|swp|sql|sqlite3?|db|log|ini|env|map)(?:\.(?:gz|zip|bz2|xz))?|~)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://xn--80abmkm6an.xn--p1ai; frame-src https://yandex.ru https://yandex.com; form-action 'self' https://xn--80abmkm6an.xn--p1ai; upgrade-insecure-requests"
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Real generated files/directories are served normally. No SPA success fallback.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
RewriteRule ^ - [R=404,L]
