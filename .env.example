# Публичный URL серверной функции для приёма заявок.
# Секретные ключи почтового сервиса должны храниться только на сервере.
VITE_FORM_ENDPOINT=

# Aggregate analytics stays same-origin by default; preview builds disable it server-side.
VITE_ANALYTICS_ENDPOINT=
# Approved nonpersonal campaign codes only; match analytics_campaigns in private PHP config.
VITE_ANALYTICS_CAMPAIGNS=
